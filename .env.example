# Copy to `.env` for docker compose (never commit real secrets).
APP_ENV=development

POSTGRES_USER=sps
POSTGRES_PASSWORD=sps
POSTGRES_DB=sps_crm

# API (host `db` is the compose service name)
DATABASE_URL=postgresql+asyncpg://sps:sps@db:5432/sps_crm
# Dev placeholder OK when APP_ENV=development. Production: >=32 chars, unique, rotate on deploy.
JWT_SECRET=change-me-in-production
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ADMIN_EMAIL=admin@stpatrickshk.com
# Dev-only seed password. Production must set a strong unique value (not changeme).
ADMIN_PASSWORD=changeme
ADMIN_FULL_NAME=SPS Admin
