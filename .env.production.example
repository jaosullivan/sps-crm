# Copy to `.env` on the host for production compose. Never commit filled values.
# Generate secrets: openssl rand -hex 32

APP_ENV=production

POSTGRES_USER=sps
POSTGRES_PASSWORD=replace-with-strong-db-password
POSTGRES_DB=sps_crm

# Host `db` is the compose service name
DATABASE_URL=postgresql+asyncpg://sps:replace-with-strong-db-password@db:5432/sps_crm

# Required: >=32 chars, unique per environment (API refuses placeholders)
JWT_SECRET=replace-with-openssl-rand-hex-32

# Comma-separated origins for the real web origin(s)
CORS_ORIGINS=https://crm.example.com

ADMIN_EMAIL=admin@stpatrickshk.com
# Required: strong unique password (not changeme)
ADMIN_PASSWORD=replace-with-strong-admin-password
ADMIN_FULL_NAME=SPS Admin
