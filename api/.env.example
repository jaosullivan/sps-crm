# Local / development defaults only — never use these outside APP_ENV=development.
APP_ENV=development
DATABASE_URL=postgresql+asyncpg://sps:sps@localhost:5432/sps_crm
# Dev placeholder OK when APP_ENV=development. Production: >=32 chars, unique, rotate on deploy.
JWT_SECRET=change-me-in-production
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ADMIN_EMAIL=admin@stpatrickshk.com
# Dev-only seed password. Production must set a strong unique value (not changeme).
ADMIN_PASSWORD=changeme
ADMIN_FULL_NAME=SPS Admin
